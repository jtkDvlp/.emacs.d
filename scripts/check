#!/usr/bin/env bash
# Load the configuration in batch mode and byte-compile it (see check.el).
#
# Usage: scripts/check [--report FILE] [--write-lock | --verify-lock]
#   --report FILE  also append the Markdown report to FILE
#   --write-lock   afterwards write etc/elpaca-lock.eld from what was
#                  installed, e.g. after updating packages
#   --verify-lock  the same, but fail if a commit changed: proves that
#                  the committed lock file installs what it says
# Environment:
#   EMACS          Emacs binary to use (default: emacs)
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

while [ $# -gt 0 ]; do
  case "$1" in
    --report) export CHECK_REPORT="$2"; shift 2 ;;
    --write-lock) export CHECK_LOCK=write; shift ;;
    --verify-lock) export CHECK_LOCK=verify; shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# NOTE: An isolated HOME keeps personal dotfiles (~/.eshellrc, ~/.gtd, a
# real ~/.emacs.d) out of the result.
home="$(mktemp -d)"
trap 'rm -rf "$home"' EXIT

# Package installs clone with git; keep the user's git settings (proxies,
# URL rewrites) despite the isolated HOME.
if [ -f "$HOME/.gitconfig" ]; then
  export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"
fi

HOME="$home" "${EMACS:-emacs}" --batch --init-directory="$root" \
    --load "$root/scripts/check.el"
